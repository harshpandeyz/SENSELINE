{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "components",
    "coverage_factor"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "observations",
              "sensitivity"
            ],
            "properties": {
              "kind": {
                "const": "type_a"
              },
              "observations": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "sensitivity": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "half_width",
              "sensitivity"
            ],
            "properties": {
              "kind": {
                "const": "type_b_rectangular"
              },
              "half_width": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "sensitivity": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "coverage_factor": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "correlation_matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
