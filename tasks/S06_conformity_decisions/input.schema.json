{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "y",
    "expanded_uncertainty",
    "lower_limit",
    "upper_limit"
  ],
  "properties": {
    "y": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "expanded_uncertainty": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "lower_limit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "upper_limit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    }
  },
  "additionalProperties": false
}
