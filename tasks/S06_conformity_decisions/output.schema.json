{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "valid",
        "lower",
        "upper",
        "decision"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "lower": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "upper": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "INDETERMINATE"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "valid",
        "reason"
      ],
      "properties": {
        "valid": {
          "const": false
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
