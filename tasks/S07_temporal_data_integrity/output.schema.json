{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "valid",
        "reason",
        "sequence_order"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "reason": {
          "type": "string"
        },
        "sequence_order": {
          "enum": [
            "FIRST",
            "NEWER"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "valid",
        "reason"
      ],
      "properties": {
        "valid": {
          "const": false
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
