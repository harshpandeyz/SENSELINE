{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sensor",
    "temporal",
    "units",
    "calibration",
    "uncertainty",
    "certificate",
    "instrument_serial",
    "measurand",
    "measurement_date",
    "specification"
  ],
  "properties": {
    "sensor": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "frame_hex",
        "width_bits",
        "byte_order",
        "signed",
        "scale",
        "rounding_places"
      ],
      "properties": {
        "frame_hex": {
          "type": "string"
        },
        "width_bits": {
          "enum": [
            8,
            16,
            24,
            32
          ]
        },
        "byte_order": {
          "enum": [
            "big",
            "little"
          ]
        },
        "signed": {
          "type": "boolean"
        },
        "scale": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "rounding_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "sentinel_codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": [
        "now_ms",
        "timestamp_ms",
        "max_age_ms",
        "allowed_future_skew_ms",
        "sequence"
      ],
      "properties": {
        "now_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_future_skew_ms": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "last_sequence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": [
        "from_unit",
        "to_unit"
      ],
      "properties": {
        "from_unit": {
          "enum": [
            "C",
            "F",
            "K",
            "Pa",
            "kPa",
            "bar",
            "V",
            "mV"
          ]
        },
        "to_unit": {
          "enum": [
            "C",
            "F",
            "K",
            "Pa",
            "kPa",
            "bar",
            "V",
            "mV"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Decode in from_unit, then convert exactly once to to_unit before calibration."
    },
    "calibration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "gain",
        "offset",
        "temp_coefficient",
        "ambient_temperature_c",
        "reference_temperature_c",
        "correction_state",
        "rounding_places"
      ],
      "properties": {
        "gain": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "offset": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "temp_coefficient": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "ambient_temperature_c": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "reference_temperature_c": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "correction_state": {
          "enum": [
            "RAW"
          ]
        },
        "rounding_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "additionalProperties": false,
      "description": "gain dimensionless; offset in to_unit; temp_coefficient in to_unit per degree Celsius; temperature difference is computed in Celsius."
    },
    "uncertainty": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "components",
        "coverage_factor"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "observations",
                  "sensitivity"
                ],
                "properties": {
                  "kind": {
                    "const": "type_a"
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    }
                  },
                  "sensitivity": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "half_width",
                  "sensitivity"
                ],
                "properties": {
                  "kind": {
                    "const": "type_b_rectangular"
                  },
                  "half_width": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "sensitivity": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "coverage_factor": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "correlation_matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false,
      "description": "All observations and half-widths are post-calibration values in to_unit; sensitivities are dimensionless; covariance has to_unit squared."
    },
    "certificate": {
      "type": "object",
      "required": [
        "serial_number",
        "measurand",
        "status",
        "valid_from",
        "valid_to",
        "range_min",
        "range_max",
        "uncertainty",
        "unit",
        "traceability_chain_status"
      ],
      "properties": {
        "serial_number": {
          "type": "string"
        },
        "measurand": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "valid_from": {
          "type": "string"
        },
        "valid_to": {
          "type": "string"
        },
        "range_min": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "range_max": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "traceability_chain_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "instrument_serial": {
      "type": "string"
    },
    "measurand": {
      "type": "string"
    },
    "measurement_date": {
      "type": "string"
    },
    "specification": {
      "type": "object",
      "required": [
        "lower_limit",
        "upper_limit"
      ],
      "properties": {
        "lower_limit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "upper_limit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
